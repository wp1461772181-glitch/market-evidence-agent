DATABASE_URL=postgresql+psycopg://market_evidence:market_evidence_dev@localhost:55432/market_evidence
# Set this only in your untracked local .env file. Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# OpenRouter Decisions API; keep the real value only in the ignored .env.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# Safe default; switch to jev only for an explicitly selected forecast trial.
FORECAST_DECISION_MODE=research_only
# Use your own reachable address. Keep the actual value in the ignored .env.
SEC_EDGAR_USER_AGENT=
# Only enable public mode when exposing FastAPI through a public HTTPS tunnel.
# Keep the actual access key in the ignored local .env file; never put it in VITE_*.
PUBLIC_API_MODE=false
APP_API_ACCESS_KEY=
CORS_ALLOWED_ORIGINS=

# Optional: how long one request to the model service may take (seconds, 10-90) and how long a streamed
# answer may run (seconds, 30-180). Slow "thinking" models may need the larger values.
# AGENT_PROVIDER_TIMEOUT_SECONDS=35
# AGENT_PROVIDER_STREAM_SECONDS=90

# Optional: how much of the earlier conversation a turn carries (KB, 16-128, default 64).  The request guard
# (twice this) and the per-turn token allowance for history follow it.  See docs/agent-context.md.
# AGENT_CONTEXT_BUDGET_KB=64

# Optional: how hard an OpenRouter reasoning model thinks per call (minimal, low, medium, high; "default" leaves
# it to the model).  Low keeps a multi-call agent turn from taking minutes.  Other providers are unaffected.
# AGENT_REASONING_EFFORT=low
